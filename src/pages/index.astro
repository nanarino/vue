---
import App from "@/layouts/app.astro"
import vue from "@/assets/vue.svg?raw"
import cloverRaw from "@/assets/clover.svg?raw"
import cloverUrl from "@/assets/clover.svg?url"
import Menu from "@/components/Menu/menu.astro"
import { getMenu } from "@/scripts/server/menu"
import LiquidLogo from "@/components/LiquidLogo/index.vue"
import ReadMe from "@/components/ReadMe/index.astro"

const menu = await getMenu("./src/pages")
const base = import.meta.env.BASE_URL
---

<App github="https://github.com/nanarino/vue">
    <div class="hero">
        <header>
            <section class="logo-bg">
                <LiquidLogo imageUrl={cloverUrl} client:only="vue" />
            </section>
            <nav class="logo">
                <a
                    class="logo clover"
                    title="@nanarino/stylus"
                    href="https://nanarino.github.io/stylus/"
                    target="_blank"
                >
                    <Fragment set:html={cloverRaw} />
                    <i>nanarino stylus design</i>
                </a>
                <a
                    class="logo vue"
                    title="vue"
                    href="https://vuejs.org/"
                    target="_blank"
                >
                    <Fragment set:html={vue} />
                    <i>vuejs</i>
                </a>
            </nav>
            <h1 class="na-font-mono" style="font-size: 5.5rem;font-weight: 400;">
                {"<na-vue/>"}
            </h1>
            <p class="na-paragraph" data-size="4" style="margin: 0;">
                一個<span class="na-font-mono">
                    @nanarino/stylus
                </span>設計語言試作的<span class="na-font-mono"> vue </span>元件合集
            </p>
        </header>
    </div>
    <nav class="pages">
        <h2 class="na-title">元件列表</h2>
        <Menu menu={menu} base={base} />
    </nav>
    <main class="readme">
        <h2 class="na-title">食用方式</h2>
        <ReadMe />
    </main>
</App>

<style>
    header {
        position: relative;
        width: 100%;
        overflow: hidden;
        user-select: none;
        display: grid;
        gap: 16px;
        align-content: center;
        height: 100vh;
        background-color: oklch(var(--white));

        @supports (height: 100dvh) {
            & {
                height: 100dvh;
            }
        }

        .logo-bg {
            --inset: 99px;
            position: absolute;
            inset: var(--inset);
        }

        h1,
        p {
            text-align: center;
            margin: 0;
            z-index: 6;
            mix-blend-mode: difference;
            color: #0f0;
            :root[data-theme="dark"] & {
                color: #f0f;
            }
        }
    }

    /*
     * 多出来的一屏滚动距离里 header 吸顶，logo-bg 先被推出画面；
     * 这段滚完 sticky 松开，页面才继续往下走。
     */
    @supports (animation-timeline: view()) {
        @media (prefers-reduced-motion: no-preference) {
            .hero {
                height: 200vh;
                view-timeline-name: --hero;
                view-timeline-axis: block;

                @supports (height: 100dvh) {
                    height: 200dvh;
                }
            }

            header {
                position: sticky;
                top: 0;

                .logo-bg {
                    /* var() 让压缩器没法把时间线并进 animation 简写，否则构建后整条声明会被浏览器丢掉 */
                    --scroll-timeline: --hero;
                    animation: logo-bg-exit linear both;
                    animation-timeline: var(--scroll-timeline);
                    animation-range: contain 0% contain 100%;
                }
            }
        }
    }

    @keyframes logo-bg-exit {
        to {
            transform: translateY(calc(-100% - var(--inset)));
        }
    }

    nav.logo {
        display: grid;
        grid-template-rows: repeat(2, min-content);
        grid-template-columns: repeat(2, min-content);
        justify-content: center;
        align-content: center;

        & a {
            display: inline-flex;
            position: relative;
            border-radius: 50%;

            & i {
                font-size: 0;
            }

            & :global(svg) {
                width: 6em;
                height: 6em;
                padding: 1.5em;
                mix-blend-mode: difference;
            }
        }
    }

    a.clover :global(path) {
        transition: 0.3s;

        &:hover {
            --pinkpurple-6: var(--lime-6);
            transform: scale(1.05) translate(-12px, -12px);
        }
    }

    a.vue :global(svg) {
        transition: 0.3s;

        &:hover {
            --magenta-5: var(--green-9);
            --pinkpurple-5: var(--green-5);
        }
    }

    nav.pages {
        padding: 2em;
        background: oklch(var(--black));
        h2 {
            padding: 0 2rem;
            color: oklch(var(--white));
        }
    }

    main.readme {
        padding: 4em;
    }
</style>
